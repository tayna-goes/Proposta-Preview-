{
    "name": "dossi-maker-site",
    "private": true,
    "version": "1.0.0",
    "description": "Build do CSS a partir dos parciais SCSS em assets/scss/",
    "scripts": {
        "build:css": "sass assets/scss/main.scss assets/css/style.css --no-source-map",
        "watch:css": "sass --watch assets/scss/main.scss:assets/css/style.css --no-source-map"
    },
    "devDependencies": {
        "sass": "^1.79.4"
    }
}
